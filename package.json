{
	"name": "personal-website",
	"description": "My own space on the web, featuring blog posts and personal highlights.",
	"author": {
		"name": "Alejandro González",
		"email": "me@alegon.dev",
		"url": "https://alegon.dev"
	},
	"version": "0.0.1",
	"license": "GPL-3.0",
	"repository": {
		"url": "https://github.com/AlexTMjugador/Home"
	},
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24.0.0 <25.0.0"
	},
	"scripts": {
		"prepare": "astro telemetry disable",
		"dev": "astro dev",
		"start": "astro dev",
		"format": "prettier --check . --plugin prettier-plugin-astro --plugin prettier-plugin-tailwindcss",
		"format:fix": "prettier --write . --plugin prettier-plugin-astro --plugin prettier-plugin-tailwindcss",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"build": "astro check && tsc --noEmit && astro build",
		"astro": "astro"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.6",
		"@eslint/js": "9.39.5",
		"@playform/inline": "0.1.4",
		"@types/markdown-it": "14.2.0",
		"@types/sanitize-html": "2.16.1",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-astro": "1.7.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"globals": "16.5.0",
		"jiti": "2.7.0",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript-eslint": "8.68.0"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "^4.3.14",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/tailwind": "^6.0.2",
		"@fontsource/exo-2": "^5.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@wbmnky/license-report-generator": "^2.3.2",
		"astro": "^7.0.0",
		"astro-compress": "^2.4.3",
		"astro-iconify": "^1.3.1",
		"astro-licenses-report": "^0.8.4",
		"astro-og-canvas": "^0.13.0",
		"astro-pagefind": "^1.8.6",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"markdown-it": "^14.3.1",
		"reading-time": "^1.5.0",
		"sanitize-html": "^2.17.7",
		"sass": "^1.103.1",
		"tailwindcss": "^3.4.19"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.6": true,
		"sharp@0.35.3": true,
		"sharp@0.32.6": true,
		"sharp@0.34.5": true,
		"esbuild@0.27.7": true,
		"esbuild@0.25.12": true
	}
